# ── 서버 ─────────────────────────────────────────────
PORT=3000
# QR 응급정보 링크에 들어갈 "외부에서 접속 가능한" 서버 주소 (배포 후 실제 주소로 변경)
PUBLIC_BASE_URL=http://localhost:3000
# 허용할 웹 출처 (쉼표 구분, * = 전체). 예: https://resq-396fc.web.app,http://localhost:5000
CORS_ORIGINS=*
# Flutter 웹 빌드 폴더 (기본 backend/public). index.html 이 있으면 / 에서 앱 화면 제공
# WEB_DIR=

# ── DB (MySQL 8 / MariaDB 10.6+) ────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=resq
DB_PASSWORD=resqpass
DB_NAME=resq
# 서버 시작 시 테이블이 없으면 자동 초기화 (db:init 과 같음, 이미 있으면 건너뜀)
DB_AUTO_INIT=true

# ── 관리자 (재난문자 수동 수집, 데모 알림, 대피소 가져오기) ──
# 비워두면 관리자 기능 비활성화. 아무도 모르는 긴 문자열로 설정하세요.
ADMIN_KEY=

# ── 재난안전데이터공유플랫폼 (www.safetydata.go.kr) ───
# 긴급재난문자 (DSSP-IF-00247)
DISASTER_API_KEY=
DISASTER_SCHEDULER_ENABLED=true
DISASTER_CRON=*/5 * * * *
# 발송 후 몇 시간 동안 '발령 중(ACTIVE)'으로 볼지
ALERT_ACTIVE_HOURS=24
# 민방위 대피시설 (DSSP-IF-00195) — 비우면 DISASTER_API_KEY 사용
SHELTER_API_KEY=
# 대피소 데이터를 가져오지 않았을 때, 사용자 위치 주변에 [샘플] 대피소를 표시 (시연용, 실제 대피소 아님)
SHELTER_SAMPLE_MODE=false

# ── 번역 (Google Cloud Translation Basic v2) ─────────
GOOGLE_TRANSLATE_API_KEY=
# 하루 번역 글자 수 상한 (무료 크레딧 월 50만 자 초과 방지)
TRANSLATE_DAILY_CHAR_LIMIT=15000

# ── 역지오코딩 (OpenStreetMap Nominatim, 키 불필요) ──
GEOCODER_PROVIDER=nominatim
# Nominatim 이용정책: 앱 식별 정보 제공 권장
CONTACT_EMAIL=
